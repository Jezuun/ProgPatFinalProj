<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../../../buttons.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Admin.ControlPanel.CreateConfController">
    <ToggleButton layoutX="495.0" layoutY="14.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="90.0" styleClass="language" text="Language" />
    <Label layoutX="450.0" layoutY="18.0" text="Admin" />
    <Label alignment="CENTER" layoutX="-1.0" layoutY="52.0" prefHeight="17.0" prefWidth="600.0" text="Create Conference">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>
    <VBox layoutX="90.0" layoutY="100.0" prefHeight="200.0" prefWidth="424.0">
        <children>
            <HBox prefHeight="40.0" prefWidth="424.0">
                <children>
                    <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="83.0" text="Title:">
                        <VBox.margin>
                            <Insets />
                        </VBox.margin>
                        <HBox.margin>
                            <Insets right="10.0" />
                        </HBox.margin></Label>
                    <TextField fx:id="title" prefHeight="25.0" prefWidth="331.0" promptText="Input Title" />
                </children></HBox>
            <HBox prefHeight="40.0" prefWidth="424.0">
                <children>
                    <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="83.0" text="Start:">
                        <VBox.margin>
                            <Insets right="10.0" />
                        </VBox.margin>
                        <HBox.margin>
                            <Insets right="10.0" />
                        </HBox.margin></Label>
                    <DatePicker fx:id="startDate" prefHeight="25.0" prefWidth="200.0" promptText="Select Date" />
                    <TextField fx:id="startTime" prefHeight="25.0" prefWidth="121.0" promptText="00:00">
                        <HBox.margin>
                            <Insets left="10.0" />
                        </HBox.margin></TextField>
                </children></HBox>
            <HBox prefHeight="40.0" prefWidth="424.0">
                <children>
                    <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="83.0" text="End:">
                        <VBox.margin>
                            <Insets right="10.0" />
                        </VBox.margin>
                        <HBox.margin>
                            <Insets right="10.0" />
                        </HBox.margin></Label>
                    <DatePicker fx:id="endDate" prefHeight="25.0" prefWidth="200.0" promptText="Select Date" />
                    <TextField fx:id="endTime" prefHeight="25.0" prefWidth="121.0" promptText="00:00">
                        <HBox.margin>
                            <Insets left="10.0" />
                        </HBox.margin></TextField>
                </children></HBox>
            <HBox prefHeight="40.0" prefWidth="424.0">
                <children>
                    <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="83.0" text="Capacity:">
                        <VBox.margin>
                            <Insets right="10.0" />
                        </VBox.margin>
                        <HBox.margin>
                            <Insets right="10.0" />
                        </HBox.margin></Label>
                    <TextField fx:id="capacity" prefHeight="25.0" prefWidth="331.0" promptText="Input Capacity" />
                </children></HBox>
            <HBox prefHeight="40.0" prefWidth="424.0">
                <children>
                    <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="83.0" text="Location:">
                        <VBox.margin>
                            <Insets right="10.0" />
                        </VBox.margin>
                        <HBox.margin>
                            <Insets right="10.0" />
                        </HBox.margin></Label>
                    <TextField fx:id="locationField" prefHeight="25.0" prefWidth="331.0" promptText="Input Location" />                </children></HBox>
        </children></VBox>
    <Button layoutX="246.0" layoutY="316.0" mnemonicParsing="false" onAction="#create" prefHeight="25.0" prefWidth="112.0" styleClass="update" text="Create" />
    <Button layoutX="533.0" layoutY="361.0" mnemonicParsing="false" onAction="#back" styleClass="logout" text="Return" />
</AnchorPane>
